# Create a NEW Supabase project. Never reuse the main Edutrip project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=founders@edutripindia.com
APP_URL=http://localhost:3000
CRON_SECRET=
UNSUBSCRIBE_SECRET=
# Remains false until setup, import qualification and template review are complete.
SEND_ENABLED=false
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465
TITAN_SMTP_USER=
TITAN_SMTP_PASSWORD=
TITAN_FROM=
# A provisioned alias forwarding to the monitored mailbox. No assumed plus-address support.
TITAN_REPLY_TO=
TITAN_IMAP_HOST=imap.titan.email
TITAN_IMAP_PORT=993
TITAN_REPLY_USER=
TITAN_REPLY_PASSWORD=
# Exact Titan folder names, comma-separated. Include Junk/Spam if replies can land there.
TITAN_REPLY_FOLDERS=INBOX
TITAN_SENDER_FOLDERS=INBOX
TITAN_SENT_FOLDER=Sent

